# Environment variables read by Hydraulik (DEV-13.1, DEV-18.3). Hydraulik reads the
# process environment and does not load .env itself: export what you need, for
# example with `set -a; . ./.env; set +a`. An empty variable counts as unset.
# Precedence: command-line option, HYDRAULIK_<KEY>, NOGAT_<KEY> (shared keys only),
# the [hydraulik] table of nogat.toml, the [nogat] table (shared keys only), the
# default. <KEY> is the dotted setting in capitals with underscores: sfincs.exe is
# HYDRAULIK_SFINCS_EXE. `hydraulik config show` lists every setting with its value
# and source. Hydraulik needs no credentials, keeps no store and no cache.

# The settings file nogat.toml; the default is in the user configuration folder of nogat.
NOGAT_CONFIG=

# --- Shared key: the variable of Hydraulik wins over the one shared by the Nogat tools ---

# Language of human-readable output: pl or en (machine output is always English).
HYDRAULIK_LANG=
NOGAT_LANG=

# --- Hydraulik ---

# Log level of the command line on stderr: debug, info, warning or error.
HYDRAULIK_LOG_LEVEL=
# SFINCS executable (default: `sfincs` on PATH).
HYDRAULIK_SFINCS_EXE=
# Docker image that runs SFINCS when no executable is found.
HYDRAULIK_SFINCS_IMAGE=
# SFINCS shared library (libsfincs) for the SWMM coupling.
HYDRAULIK_SFINCS_LIBRARY=
# Unit of qext in that library: m3s (SFINCS main since PR 355) or ms (v2.4.1).
HYDRAULIK_SFINCS_QEXT_UNIT=
# Seconds one SFINCS run may take, and the OpenMP threads of one run.
HYDRAULIK_SFINCS_TIMEOUT_S=
HYDRAULIK_SFINCS_THREADS=
# Docker command (default: docker).
HYDRAULIK_DOCKER_EXE=
# Kartograf command (default: `kartograf` on PATH) and the seconds one download may take.
HYDRAULIK_KARTOGRAF_EXE=
HYDRAULIK_KARTOGRAF_TIMEOUT_S=
