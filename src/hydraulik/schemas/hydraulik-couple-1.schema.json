{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydraulik/schemas/hydraulik-couple-1.schema.json",
  "title": "hydraulik-couple/1",
  "description": "One coupled SFINCS and SWMM run: the water balance, the surface and network results and the exchange of every node (`model couple`).",
  "type": "object",
  "required": ["schema", "engine", "coupling", "balance", "surface", "network", "nodes", "elapsed_s", "files"],
  "properties": {
    "schema": {"const": "hydraulik-couple/1"},
    "engine": {
      "type": "object",
      "required": ["sfincs", "swmm"],
      "properties": {
        "sfincs": {
          "type": "object",
          "required": ["library", "qext_unit"],
          "properties": {
            "library": {"type": ["string", "null"]},
            "build_revision": {"type": ["string", "null"]},
            "qext_unit": {"enum": ["m3s", "ms"]}
          }
        },
        "swmm": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"const": "pyswmm"},
            "version": {"type": ["string", "null"]},
            "toolkit": {"type": ["string", "null"]}
          }
        }
      }
    },
    "coupling": {
      "type": "object",
      "required": [
        "mode",
        "exchange_interval_s",
        "relaxation",
        "rim_tolerance_m",
        "inlet",
        "intervals",
        "overshoot_s",
        "capped_steps",
        "nodes_outside"
      ],
      "properties": {
        "mode": {"enum": ["swmm_flooding", "coordinator"]},
        "exchange_interval_s": {"type": "integer", "minimum": 1},
        "relaxation": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rim_tolerance_m": {"type": "number", "minimum": 0},
        "inlet": {
          "type": "object",
          "required": ["area_m2", "weir_coefficient", "orifice_coefficient"],
          "properties": {
            "area_m2": {"type": "number", "exclusiveMinimum": 0},
            "weir_coefficient": {"type": "number", "minimum": 0},
            "orifice_coefficient": {"type": "number", "minimum": 0}
          }
        },
        "intervals": {"type": "integer", "minimum": 1},
        "overshoot_s": {
          "type": "object",
          "required": ["mean", "max"],
          "properties": {"mean": {"type": "number"}, "max": {"type": "number"}}
        },
        "capped_steps": {"type": "integer", "minimum": 0},
        "nodes_outside": {"type": "array", "items": {"type": "string"}}
      }
    },
    "balance": {
      "type": "object",
      "required": [
        "rain_m3",
        "inflow_m3",
        "infiltration_m3",
        "surface_m3",
        "network_m3",
        "outfall_net_m3",
        "outfall_gross_inflow_m3",
        "sink_m3",
        "exchanged_m3",
        "pending_m3",
        "lost_flooding_m3",
        "total_error_m3",
        "surface_side_error_m3",
        "network_side_error_m3",
        "total_error_percent",
        "open_boundary",
        "flags"
      ],
      "properties": {
        "rain_m3": {"type": "number"},
        "inflow_m3": {"type": "number"},
        "infiltration_m3": {"type": "number"},
        "surface_m3": {"type": "number"},
        "network_m3": {"type": "number"},
        "outfall_net_m3": {"type": "number"},
        "outfall_gross_inflow_m3": {"type": "number"},
        "sink_m3": {"type": "number"},
        "exchanged_m3": {"type": "number"},
        "pending_m3": {"type": "number"},
        "lost_flooding_m3": {"type": "number"},
        "total_error_m3": {"type": "number"},
        "surface_side_error_m3": {"type": "number"},
        "network_side_error_m3": {"type": "number"},
        "total_error_percent": {"type": "number"},
        "open_boundary": {"type": "boolean"},
        "expected_rain_m3": {"type": ["number", "null"]},
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "balance_residual",
              "balance_gain",
              "rain_mismatch",
              "time_mismatch",
              "no_rain_output"
            ]
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["grid", "depth", "stations"],
      "properties": {
        "grid": {"type": "object"},
        "depth": {"type": "object"},
        "stations": {"type": "array", "items": {"type": "object"}}
      }
    },
    "network": {
      "type": "object",
      "required": ["duration_s", "totals", "nodes", "conduits"],
      "properties": {
        "duration_s": {"type": "number", "minimum": 0},
        "totals": {
          "type": "object",
          "required": [
            "external_inflow_m3",
            "outflow_m3",
            "flooding_m3",
            "final_storage_m3",
            "continuity_error_percent"
          ],
          "properties": {
            "external_inflow_m3": {"type": "number"},
            "outflow_m3": {"type": "number"},
            "flooding_m3": {"type": "number"},
            "final_storage_m3": {"type": "number"},
            "continuity_error_percent": {"type": "number"}
          }
        },
        "nodes": {"type": "array", "items": {"type": "object"}},
        "conduits": {"type": "array", "items": {"type": "object"}}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "cell",
          "ground_m",
          "exchanged_m3",
          "flooded_m3",
          "returned_m3",
          "pending_m3",
          "capped_steps",
          "peak_exchange_m3s",
          "peak_return_m3s",
          "max_level_m",
          "max_head_m",
          "held_max_head_m",
          "numerical_spike",
          "sign_flips",
          "spill"
        ],
        "properties": {
          "name": {"type": "string"},
          "cell": {"type": "integer", "minimum": 0},
          "ground_m": {"type": "number"},
          "exchanged_m3": {"type": "number"},
          "flooded_m3": {"type": "number", "minimum": 0},
          "returned_m3": {"type": "number"},
          "pending_m3": {"type": "number"},
          "capped_steps": {"type": "integer", "minimum": 0},
          "peak_exchange_m3s": {"type": "number"},
          "peak_return_m3s": {"type": "number"},
          "max_level_m": {"type": "number"},
          "max_head_m": {"type": "number"},
          "held_max_head_m": {"type": "number"},
          "numerical_spike": {"type": "boolean"},
          "sign_flips": {"type": "integer", "minimum": 0},
          "spill": {
            "type": "object",
            "required": ["total_m3", "sustained_m3", "sustained", "longest_s"],
            "properties": {
              "total_m3": {"type": "number"},
              "sustained_m3": {"type": "number"},
              "sustained": {"type": "boolean"},
              "longest_s": {"type": "number"}
            }
          }
        }
      }
    },
    "elapsed_s": {"type": "number", "minimum": 0},
    "files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "status"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["written", "replaced"]}
        }
      }
    }
  }
}
