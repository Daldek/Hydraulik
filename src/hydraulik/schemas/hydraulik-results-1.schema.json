{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydraulik/schemas/hydraulik-results-1.schema.json",
  "title": "hydraulik-results/1",
  "description": "What a SFINCS run computed: grid, maxima, flooded areas, water balance, stations (`results read`).",
  "type": "object",
  "required": ["schema", "source", "engine", "grid", "depth", "balance", "stations"],
  "properties": {
    "schema": {"const": "hydraulik-results/1"},
    "source": {"type": "string"},
    "engine": {
      "type": "object",
      "properties": {
        "build_revision": {"type": ["string", "null"]},
        "status": {"type": ["integer", "null"]},
        "runtime_s": {"type": ["number", "null"]},
        "average_dt_s": {"type": ["number", "null"]}
      }
    },
    "grid": {
      "type": "object",
      "required": ["epsg", "dx_m", "x0_m", "y0_m", "rows", "columns", "active_cells", "area_m2"],
      "properties": {
        "epsg": {"type": "integer"},
        "dx_m": {"type": "number", "exclusiveMinimum": 0},
        "x0_m": {"type": "number"},
        "y0_m": {"type": "number"},
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "active_cells": {"type": "integer", "minimum": 0},
        "area_m2": {"type": "number", "minimum": 0},
        "huthresh_m": {"type": ["number", "null"]}
      }
    },
    "depth": {
      "type": "object",
      "required": ["max_depth_m", "max_velocity_ms", "flooded_area_m2"],
      "properties": {
        "max_depth_m": {"type": "number", "minimum": 0},
        "max_depth_x_m": {"type": ["number", "null"]},
        "max_depth_y_m": {"type": ["number", "null"]},
        "max_velocity_ms": {"type": "number", "minimum": 0},
        "flooded_area_m2": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["threshold_m", "area_m2"],
            "properties": {
              "threshold_m": {"type": "number", "exclusiveMinimum": 0},
              "area_m2": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "balance": {
      "type": "object",
      "required": [
        "rain_m3", "infiltration_m3", "stored_m3", "residual_m3", "residual_percent",
        "open_boundary", "flags"
      ],
      "properties": {
        "rain_m3": {"type": "number"},
        "infiltration_m3": {"type": "number"},
        "stored_m3": {"type": "number"},
        "residual_m3": {"type": "number"},
        "residual_percent": {"type": "number"},
        "open_boundary": {"type": "boolean"},
        "expected_rain_m3": {"type": ["number", "null"]},
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "balance_residual", "balance_gain", "rain_mismatch", "time_mismatch",
              "no_rain_output"
            ]
          }
        }
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "x_m", "y_m", "max_depth_m", "time_of_max_s"],
        "properties": {
          "name": {"type": "string"},
          "x_m": {"type": "number"},
          "y_m": {"type": "number"},
          "max_depth_m": {"type": "number", "minimum": 0},
          "time_of_max_s": {"type": "number"}
        }
      }
    }
  }
}
