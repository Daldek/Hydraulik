{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydraulik/schemas/hydraulik-plan-1.schema.json",
  "title": "hydraulik-plan/1",
  "description": "The plan of `--check`: every target with its action, nothing written (DEV-19.10).",
  "type": "object",
  "required": ["schema", "output_dir", "force", "targets", "conflicts", "steps"],
  "properties": {
    "schema": {"const": "hydraulik-plan/1"},
    "output_dir": {"type": "string"},
    "force": {"type": "boolean"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "action"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "action": {"enum": ["write", "replace", "conflict"]},
          "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {"enum": ["output_in_store", "duplicate_output_name", "output_exists"]}
    },
    "steps": {"type": "array", "items": {"type": "string"}},
    "blockers": {
      "type": "array",
      "description": "Reasons other than the output that would make the real run fail.",
      "items": {
        "type": "object",
        "required": ["reason", "message"],
        "properties": {
          "reason": {"enum": ["engine_missing", "engine_incompatible", "extra_missing"]},
          "message": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    }
  }
}
