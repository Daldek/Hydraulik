{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydraulik/schemas/hydraulik-export-1.schema.json",
  "title": "hydraulik-export/1",
  "description": "A map or a table written from the results of a run (`results export`).",
  "type": "object",
  "required": ["schema", "variable", "format", "source", "files"],
  "properties": {
    "schema": {"const": "hydraulik-export/1"},
    "variable": {
      "enum": ["max_depth", "max_velocity", "final_depth", "infiltration", "stations"]
    },
    "format": {"enum": ["geotiff", "csv"]},
    "source": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "status"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["written", "replaced"]}
        }
      }
    }
  }
}
